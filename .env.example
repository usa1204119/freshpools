# ─── Database (Neon / any Postgres) ──────────────────────────────────────────
# Leave blank in local preview mode — the site renders with empty states.
DATABASE_URL=

# ─── Auth.js v5 ──────────────────────────────────────────────────────────────
# openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="FreshPools <hello@freshpools.in>"
# Internal inbox that receives requirement + college enquiry notifications
NOTIFY_EMAIL=hello@freshpools.in

# ─── Payments (Razorpay) ─────────────────────────────────────────────────────
# Use rzp_test_* keys until the full flow is verified end to end.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ─── File uploads (UploadThing) ──────────────────────────────────────────────
# Optional. Without it the profile form shows plain URL fields instead of an
# uploader, which is how the site worked before uploads existed.
UPLOADTHING_TOKEN=

# ─── Rate limiting (Upstash Redis) ───────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Analytics (Plausible / Umami) ───────────────────────────────────────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
